rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Explicit operational collections for app features
    match /notifications/{id} {
      allow read, write: if true;
    }
    match /products/{id} {
      allow read, write: if true;
    }
    match /orders/{id} {
      allow read, write: if true;
    }
    match /customers/{id} {
      allow read, write: if true;
    }
    match /users/{id} {
      allow read, write: if true;
    }
    match /suppliers/{id} {
      allow read, write: if true;
    }
    match /expenses/{id} {
      allow read, write: if true;
    }
    match /incomes/{id} {
      allow read, write: if true;
    }
    match /branches/{id} {
      allow read, write: if true;
    }
    match /categories/{id} {
      allow read, write: if true;
    }
    match /brands/{id} {
      allow read, write: if true;
    }
    match /colors/{id} {
      allow read, write: if true;
    }
    match /models/{id} {
      allow read, write: if true;
    }
    match /settings/{id} {
      allow read, write: if true;
    }

    // Accounting & Financial Health collections
    match /investments/{id} {
      allow read, write: if true;
    }
    match /companyPurchases/{id} {
      allow read, write: if true;
    }
    match /companyLosses/{id} {
      allow read, write: if true;
    }
    match /cashReconciliations/{id} {
      allow read, write: if true;
    }
    match /otherReceivables/{id} {
      allow read, write: if true;
    }
    match /paymentPlatformLedger/{id} {
      allow read, write: if true;
    }
    match /importShippingCosts/{id} {
      allow read, write: if true;
    }
    match /chartOfAccounts/{id} {
      allow read, write: if true;
    }
    match /accountingVouchers/{id} {
      allow read, write: if true;
    }

    // Catch-all fallback for any other collections or nested documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

