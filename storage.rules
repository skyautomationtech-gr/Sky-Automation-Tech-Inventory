rules_version = '2';

// Firebase Storage Security Rules for Sky Automation Tech / GadgetZu / RTX Gadget ERP
// Publish these rules in Firebase Console -> Storage -> Rules.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedImage(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function isAllowedDocument(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    // Catalog product photos & thumbnails (signed-in read & write up to 2 MB)
    match /products/{folder}/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Pre-Order product photos & thumbnails:
    // Public single-file GET allowed so the customer tracking portal (/track/:token) can render item photos;
    // directory listing stays disabled; writes require signed-in user + image <= 2 MB.
    match /preOrders/products/{allPaths=**} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Pre-Order payment receipts (private, signed-in users only)
    match /preOrders/receipts/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Pre-Order shipment documents & shipping expense receipts (images or PDF up to 5 MB, signed-in only)
    match /preOrders/{preOrderId}/docs/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedDocument(5 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Profile photos: signed-in read, user can only write/delete their own folder
    match /profilePhotos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Operator avatars uploaded during staff onboarding
    match /operator_avatars/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Company & Sub-brand logos:
    // Public GET allowed so public tracking & invoice verification pages can render brand logos.
    match /logos/{allPaths=**} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Financial expense receipts (signed-in users only)
    match /receipts/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isAllowedImage(2 * 1024 * 1024);
      allow delete: if isSignedIn();
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
